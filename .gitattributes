# Normalize line endings on checkout and commit.
# src/.editorconfig requires LF (end_of_line = lf) and the IDE0055 formatter fails
# the build on CRLF checkouts (Git for Windows defaults to core.autocrlf=true), so
# every clone must get LF regardless of the local autocrlf setting. See APIPUB-158.
* text=auto eol=lf

# Binary files
*.png binary
