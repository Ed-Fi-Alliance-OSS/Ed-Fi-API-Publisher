# Arm A: ODS/API 7.1 on Data Standard 4.0.0 (Texas 2026-27 configuration). Published Docker Hub images, PostgreSQL.
# Read by docker compose (ods-arm.yml) and by lib/Regression.psm1 (Get-Arm). Development-only credentials.
ARM_TYPE=ods
ARM_DESCRIPTION=ODS/API 7.1 on Data Standard 4.0.0
COMPOSE_PROJECT_NAME=apipub-reg-a

# Tag verified on Docker Hub 2026-09-23 for ods-api-web-api, ods-api-db-ods-sandbox and ods-api-db-admin.
ODS_IMAGE_TAG=7.1-4.0.0
TPDM_ENABLED=true
WIREMOCK_TAG=3.13.2

# Host ports (Northridge keeps 8001/8003, the 7.1 side stack 8011; each arm gets its own hundred).
SOURCE_PORT=8101
TARGET_PORT=8103
SWAGGER_PORT=8102
PROXY_PORT=8180
ADMIN_DB_PORT=5401

LOGS_FOLDER=./.logs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=P@ssw0rd-regression
POSTGRES_DB=postgres
ODS_CONNECTION_STRING_ENCRYPTION_KEY=rT3yP9/UYK5msQwbgRAg95POyBush+hDmOP34tjgSOs=

# Token lifetime the source API hands out, in minutes (30 = ODS default; lower it for item 4 dry runs).
SOURCE_TOKEN_TIMEOUT_MINUTES=30

# API clients created by bootstrap-pgsql.sql. Claim sets default to 'Ed-Fi Sandbox' (present in every
# Security database); switch to 'Ed-Fi API Publisher - Reader' / '- Writer' where the arm ships them.
SOURCE_ODS_DB=EdFi_Ods_Populated
TARGET_ODS_DB=EdFi_Ods_Minimal
SOURCE_KEY=regressionSourceKey
SOURCE_SECRET=regressionSourceSecret
SOURCE_CLAIM_SET=Ed-Fi Sandbox
TARGET_KEY=regressionTargetKey
TARGET_SECRET=regressionTargetSecret
TARGET_CLAIM_SET=Ed-Fi Sandbox
