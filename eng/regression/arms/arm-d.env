# Arm D: Ed-Fi DMS 8.x target with Keycloak (APIPUB-146). The DMS stack is started from the DMS repository, not
# from this folder (see arm-d-dms.md); this file only tells the harness where it is. The source is arm B's
# Grand Bend API (start arm B first) or the Northridge stack for a large run.
ARM_TYPE=dms
ARM_DESCRIPTION=Ed-Fi DMS 8.x target (Keycloak) from an ODS/API 7.3.2 source

# Source: arm B by default.
SOURCE_URL=http://localhost:8201/
SOURCE_KEY=regressionSourceKey
SOURCE_SECRET=regressionSourceSecret

# Target: local DMS from Data-Management-Service/eng/docker-compose (DMS_HTTP_PORTS=8080 in its .env).
TARGET_URL=http://localhost:8080/
TARGET_KEY=
TARGET_SECRET=

# Container-mode publisher runs join this Docker network and use these names instead of localhost.
# Leave DOCKER_NETWORK empty to run the publisher as a local exe only.
DOCKER_NETWORK=
SOURCE_URL_IN_NETWORK=
TARGET_URL_IN_NETWORK=

# Keycloak admin endpoint, used by the D2/D4 items to confirm which identity provider the DMS is using.
KEYCLOAK_URL=http://localhost:8045/

# PowerShell command that returns the DMS to an empty, provisioned schema; run by Reset-RegressionTarget before D3
# (see arm-d-dms.md, "Reset between items"). Put the machine-specific value in arm-d.local.env.
TARGET_RESET_COMMAND=

# Source records a DMS target rejects as invalid while an ODS/API accepts them, as resource=count pairs. On a DMS
# target the count checks expect exactly this shortfall and the publisher tolerates that many rejected documents.
# These are the Grand Bend values: degreeSpecializations without the required beginDate, and financial aids for
# students the source does not have. Override in arm-d.local.env for another source (empty for none).
KNOWN_TARGET_REJECTIONS=/tpdm/candidateEducatorPreparationProgramAssociations=1000,/tpdm/financialAids=11
