# Arm D: Ed-Fi DMS 8.x target with Keycloak (APIPUB-146). The DMS stack is started from the DMS repository, not
# from this folder (see arm-d-dms.md); this file only tells the harness where it is. The source is arm B's
# Grand Bend API (start arm B first) or the Northridge stack for a large run.
ARM_TYPE=dms
ARM_DESCRIPTION=Ed-Fi DMS 8.x target (Keycloak) from an ODS/API 7.3.2 source

# Source: arm B by default.
SOURCE_URL=http://localhost:8201/
SOURCE_KEY=regressionSourceKey
SOURCE_SECRET=regressionSourceSecret

# Target: local DMS from Data-Management-Service/eng/docker-compose (DMS_HTTP_PORTS=8080 in its .env).
TARGET_URL=http://localhost:8080/
TARGET_KEY=
TARGET_SECRET=

# Container-mode publisher runs join this Docker network and use these names instead of localhost.
# Leave DOCKER_NETWORK empty to run the publisher as a local exe only.
DOCKER_NETWORK=
SOURCE_URL_IN_NETWORK=
TARGET_URL_IN_NETWORK=

# Keycloak admin endpoint, used by the D2/D4 items to confirm which identity provider the DMS is using.
KEYCLOAK_URL=http://localhost:8045/

# PowerShell command that returns the DMS to an empty, provisioned schema; run by Reset-RegressionTarget before D3
# (see arm-d-dms.md, "Reset between items"). Put the machine-specific value in arm-d.local.env.
TARGET_RESET_COMMAND=

# Source records a DMS target rejects as invalid while an ODS/API accepts them, as resource=count pairs (the count is
# for the reader; the runner uses the resource). From an ODS/API source into a DMS target the runner excludes these
# resources (--exclude) unless the item scopes the run with --include or --includeOnly. A DMS source never holds
# them, so the key does not apply to it.
# This is arm B's source (the default): 1,000 candidate educator preparation program associations whose
# degreeSpecializations lack the required beginDate. Other sources differ (a Grand Bend sandbox built from the
# 7.3.2 populated template also has 11 financial aids for students it does not hold), so override the key in
# arm-d.local.env for another source, empty for none.
KNOWN_TARGET_REJECTIONS=/tpdm/candidateEducatorPreparationProgramAssociations=1000

# Resources a DMS source and an ODS/API target hold differently by design, comma-separated. From a DMS source into an
# ODS/API target the runner excludes them (--exclude) unless the item scopes the run with --include or --includeOnly.
# Data Standard 5.x ships three tribal affiliation descriptors whose codeValue ends with a space; the ODS/API keeps the
# space and the DMS trims it, so publishing them from a DMS into an ODS/API adds three trimmed copies (620 vs 623).
# Fixed in Data Standard 6.0; set the key empty in arm-d.local.env for a 6.x pairing.
KNOWN_DMS_TO_ODS_DIVERGENCES=/ed-fi/tribalAffiliationDescriptors
