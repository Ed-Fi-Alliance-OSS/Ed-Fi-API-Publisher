# Arm C: ODS/API 7.3.2 on Data Standard 6.1.0. Published Docker Hub images, PostgreSQL.
# Read by docker compose (ods-arm.yml) and by lib/Regression.psm1 (Get-Arm).
ARM_TYPE=ods
ARM_DESCRIPTION=ODS/API 7.3.2 on Data Standard 6.1.0
COMPOSE_PROJECT_NAME=apipub-reg-c

# Only a build-suffixed tag is published for 6.1.0 (no plain 7.3.2-6.1.0); verified on Docker Hub 2026-09-23.
ODS_IMAGE_TAG=7.3.2_6447-6.1.0
# The sandbox image ships no TPDM templates for Data Standard 6.x, so the plugin stays off.
TPDM_ENABLED=false
WIREMOCK_TAG=3.13.2

SOURCE_PORT=8301
TARGET_PORT=8303
SWAGGER_PORT=8302
PROXY_PORT=8380
ADMIN_DB_PORT=5403

LOGS_FOLDER=./.logs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=P@ssw0rd-regression
POSTGRES_DB=postgres
ODS_CONNECTION_STRING_ENCRYPTION_KEY=rT3yP9/UYK5msQwbgRAg95POyBush+hDmOP34tjgSOs=

SOURCE_TOKEN_TIMEOUT_MINUTES=30

SOURCE_ODS_DB=EdFi_Ods_Populated
TARGET_ODS_DB=EdFi_Ods_Minimal
SOURCE_KEY=regressionSourceKey
SOURCE_SECRET=regressionSourceSecret
SOURCE_CLAIM_SET=Ed-Fi Sandbox
TARGET_KEY=regressionTargetKey
TARGET_SECRET=regressionTargetSecret
TARGET_CLAIM_SET=Ed-Fi Sandbox
