# Northridge source for the long runs (items 3 and 4): ODS/API 7.3.2 on Data Standard 5.2.0, SQL Server.
# Not an arm. The target stays arm B's; this stack only serves EdFi_Ods_Northridge (10.6 M documents), which lives
# on the HOST SQL Server (restored by ../../Start-NorthridgeSource.ps1 from the public backup). Read by docker compose
# (northridge.yml) and by Start-NorthridgeSource.ps1. Per-machine overrides go in northridge.local.env (git-ignored).
ARM_TYPE=northridge-source
ARM_DESCRIPTION=Northridge source: ODS/API 7.3.2 on Data Standard 5.2.0, SQL Server on the host
COMPOSE_PROJECT_NAME=apipub-reg-northridge

# Published image for the API (verified on Docker Hub 2026-10-01); no -mssql tag exists for ods-api-db-admin, so the
# Admin/Security server is built from db-admin-mssql/ with the 7.3 database packages of the Ed-Fi Azure feed.
ODS_IMAGE_TAG=7.3.2-5.2.0-mssql
STANDARD_VERSION=5.2.0
ADMIN_VERSION=7.3.20021
SECURITY_VERSION=7.3.20023
# Leave unset to build db-admin from the pinned upstream base. A machine whose Docker daemon cannot reach
# mcr.microsoft.com sets this (in northridge.local.env) to the same tag without the digest, so the build uses the local copy.
# DB_ADMIN_BASE_IMAGE=mcr.microsoft.com/mssql/server:2022-CU15-ubuntu-22.04

# The ports the laptop runbook used; the arm ports (81xx, 82xx, 83xx) stay clear.
NORTHRIDGE_PORT=8001
NORTHRIDGE_SWAGGER_PORT=8002

LOGS_FOLDER=./.logs

# Login the API uses inside the containers (created by the db-admin image on first start).
SQLSERVER_USER=edfi
SQLSERVER_PASSWORD=P@ssw0rd-regression
ODS_CONNECTION_STRING_ENCRYPTION_KEY=rT3yP9/UYK5msQwbgRAg95POyBush+hDmOP34tjgSOs=
BEARER_TOKEN_PER_CLIENT_LIMIT=1000
SOURCE_TOKEN_TIMEOUT_MINUTES=30

# How the API container reaches the host SQL Server, and the SQL login Start-NorthridgeSource.ps1 creates (or
# re-passwords) there. No ';' or '$(' in the password: the value is spliced into a connection string by sqlcmd.
HOST_SQLSERVER_SERVER=host.docker.internal,1433
HOST_SQLSERVER_USER=edfi_docker
HOST_SQLSERVER_PASSWORD=EdFiDocker-regression!1
HOST_NORTHRIDGE_DB=EdFi_Ods_Northridge

# Public backup (730 MB download, 15 GB .bak, about 17 GB restored). The .7z lands in .backups/ (git-ignored).
NORTHRIDGE_BACKUP_URL=https://odsassets.blob.core.windows.net/public/Northridge/EdFi_Ods_Northridge_v73_20241218.7z
NORTHRIDGE_BACKUP_FILE=EdFi_Ods_Northridge_v73_20241218.bak

# API client the items use as SOURCE_KEY / SOURCE_SECRET in arm-b.local.env. The claim set ships with the 7.3
# Security database. The education organizations are the LEA and ESC present in the backup.
NORTHRIDGE_KEY=northridgeKey
NORTHRIDGE_SECRET=northridgeSecret
NORTHRIDGE_CLAIM_SET=Ed-Fi API Publisher - Reader
NORTHRIDGE_ED_ORGS=255900,255901
# Namespaces the Northridge documents use that arm B's vendor is not registered for: the learning standards are under
# http://ed-fi.org/LearningStandard/..., and some descriptors under uri://northridge.org/... (the target refuses both
# with 403 "The 'Namespace' value of the data does not start with ..." until the vendor has the prefixes).
NORTHRIDGE_NAMESPACE_PREFIXES=http://ed-fi.org,uri://northridge.org
