# Arm B: ODS/API 7.3.2 on Data Standard 5.2.0. Published Docker Hub images, PostgreSQL.
# Grand Bend for the functional items; the memory and throttling long runs use the Northridge stack instead
# (see README, "Manual residue"). Read by docker compose (ods-arm.yml) and by lib/Regression.psm1 (Get-Arm).
ARM_TYPE=ods
ARM_DESCRIPTION=ODS/API 7.3.2 on Data Standard 5.2.0
COMPOSE_PROJECT_NAME=apipub-reg-b

# Tag verified on Docker Hub 2026-09-23 for ods-api-web-api, ods-api-db-ods-sandbox and ods-api-db-admin.
ODS_IMAGE_TAG=7.3.2-5.2.0
TPDM_ENABLED=true
WIREMOCK_TAG=3.13.2

SOURCE_PORT=8201
TARGET_PORT=8203
SWAGGER_PORT=8202
PROXY_PORT=8280
ADMIN_DB_PORT=5402

LOGS_FOLDER=./.logs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=P@ssw0rd-regression
POSTGRES_DB=postgres
ODS_CONNECTION_STRING_ENCRYPTION_KEY=rT3yP9/UYK5msQwbgRAg95POyBush+hDmOP34tjgSOs=

SOURCE_TOKEN_TIMEOUT_MINUTES=30

SOURCE_ODS_DB=EdFi_Ods_Populated
TARGET_ODS_DB=EdFi_Ods_Minimal
SOURCE_KEY=regressionSourceKey
SOURCE_SECRET=regressionSourceSecret
SOURCE_CLAIM_SET=Ed-Fi Sandbox
TARGET_KEY=regressionTargetKey
TARGET_SECRET=regressionTargetSecret
TARGET_CLAIM_SET=Ed-Fi Sandbox
